#############################################################################
# Documentación de las variables de la API. NO se copia a .env.
#
# Los valores reales viven en Doppler (proyecto admin-prop, config dev_backend
# en local) y se inyectan con `doppler run --`, que ya envuelve a los scripts
# de package.json. La app ignora cualquier archivo .env aunque exista.
#
# Los valores de acá son ejemplos obviamente falsos. Si agregás una variable,
# documentala acá y creala en Doppler.
#
# Todas estas variables se validan al arrancar (src/shared/config/env.validation.ts).
# Si falta una obligatoria o está mal tipada, la app no levanta y te dice cuál.
#############################################################################

# ─────────────────────────────────────────────────────────── Aplicación ─────
# development | test | qa | production
NODE_ENV=development
APP_NAME=adminprop-api
PORT=3000

# error | warn | info | debug | verbose
LOG_LEVEL=debug

# Swagger en /swagger. Por defecto: apagado en producción, encendido afuera.
SWAGGER_ENABLED=true

# Tamaño máximo del body de un request.
BODY_LIMIT=1mb

# Poné true si la app corre detrás de un balanceador o ingress. Sin esto,
# req.ip es la IP del proxy y el rate limiting cuenta todo como un solo cliente.
# Por defecto: true en producción.
# TRUST_PROXY=false


# ───────────────────────────────────────────────────────── Base de datos ─────
# OBLIGATORIA
DATABASE_URL="postgresql://usuario:password@localhost:5432/adminprop"

# Para el docker-compose de desarrollo:
# DATABASE_URL="postgresql://adminprop:adminprop@localhost:5432/adminprop_development"


# ───────────────────────────────────────────────────────────── Secretos ─────
# Proveedor de secretos. Hoy sólo "env" (lee de este archivo y del entorno).
# Para enchufar un secret manager externo mirá
# src/shared/config/secrets/load-secrets.ts
SECRETS_PROVIDER=env


# ────────────────────────────────────────────────────────────────── JWT ─────
# OBLIGATORIOS. Mínimo 32 caracteres y TIENEN que ser distintos entre sí:
# si comparten secreto, un refresh token sirve como access token.
#
#   openssl rand -base64 48
#
# En producción NO los pongas en un archivo: inyectalos como variables de
# entorno desde tu plataforma (secrets de Kubernetes, ECS task definition, etc).
JWT_ACCESS_SECRET=REEMPLAZAME_con_openssl_rand_base64_48_minimo_32_chars
JWT_REFRESH_SECRET=REEMPLAZAME_con_OTRO_openssl_rand_base64_48_distinto_al_de_arriba

# Vida del access token. Corto a propósito: no se valida contra la base en cada
# request, así que es la ventana en la que una sesión revocada sigue viva.
JWT_ACCESS_TTL=15m

# Vida del refresh token. Rota en cada uso.
JWT_REFRESH_TTL=7d

# Claims iss/aud. Por defecto salen de APP_NAME.
# JWT_ISSUER=adminprop-api
# JWT_AUDIENCE=adminprop-clients

# Costo de bcrypt (10-15). Más alto = más lento de crackear y de loguear.
BCRYPT_SALT_ROUNDS=12

# Valida el usuario contra la base en CADA request: permite banear o cerrar
# sesiones al instante, a costa de una consulta por request. Por defecto false.
# JWT_VALIDATE_USER_ON_REQUEST=false


# ──────────────────────────────────────────────── Bloqueo de cuentas ─────
# Frena la fuerza bruta contra una cuenta puntual, que el rate limit por IP no
# cubre si el atacante rota IPs.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15


# ────────────────────────────────────────────────────── Rate limiting ─────
# Se aplican las tres ventanas a la vez: alcanza con pasarse de una para un 429.
# Los TTL van en SEGUNDOS.
THROTTLE_ENABLED=true

# Ráfagas
THROTTLE_SHORT_TTL=1
THROTTLE_SHORT_LIMIT=10

# Uso normal sostenido
THROTTLE_MEDIUM_TTL=60
THROTTLE_MEDIUM_LIMIT=120

# Techo por cliente
THROTTLE_LONG_TTL=3600
THROTTLE_LONG_LIMIT=2000

# Endpoints de auth (login, registro, refresh, cambio de contraseña).
# Mucho más estricto: 10 intentos cada 15 minutos.
THROTTLE_AUTH_TTL=900
THROTTLE_AUTH_LIMIT=10


# ───────────────────────────────────────────────────────────────── CORS ─────
# Lista separada por comas. Si no la definís, CORS queda DESHABILITADO.
# "*" permite cualquier origen: sólo para desarrollo.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false


# ──────────────────────────────────────────── Seed (npm run prisma:seed) ─────
# Crea la primera inmobiliaria (tenant) y su administrador. Idempotente.
SEED_TENANT_NAME="Inmobiliaria de Ejemplo"
SEED_TENANT_SLUG=inmobiliaria-ejemplo
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=Admin
# SEED_ADMIN_LAST_NAME=


# ────────────────────────────────────────────────────────────── Cola ─────
# pgboss (default): cola real sobre el mismo Postgres, schema "pgboss".
# memory: sólo para tests unitarios.
# QUEUE_PROVIDER=pgboss


# ─────────────────────────────────────────────────────────── Storage ─────
# local (default): disco, servido en /files. cloudinary: el del MVP desplegado.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=storage-data
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000

# Obligatorias sólo con STORAGE_PROVIDER=cloudinary.
# Cloudinary → Settings → API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
