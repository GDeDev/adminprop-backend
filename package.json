{
  "name": "adminprop-backend",
  "version": "0.1.0",
  "description": "API de administración de propiedades. NestJS con arquitectura hexagonal, CQRS y autenticación JWT propia.",
  "author": "GDeDev",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GDeDev/adminprop-backend.git"
  },
  "bugs": {
    "url": "https://github.com/GDeDev/adminprop-backend/issues"
  },
  "homepage": "https://github.com/GDeDev/adminprop-backend#readme",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:all": "prettier --write .",
    "start": "doppler run -- nest start",
    "start:dev": "doppler run -- nest start --watch",
    "start:debug": "doppler run -- nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:qa": "NODE_ENV=qa node dist/src/main",
    "start:production": "NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "code:check": "npm run format:check && npm run lint:check",
    "code:fix": "npm run format && npm run lint:fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:unit": "jest --testPathIgnorePatterns=.*\\.e2e-spec\\.ts$",
    "test:cov:open": "npm run test:cov && open coverage/lcov-report/index.html",
    "test:cov:ci": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "doppler run -- prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "doppler run -- prisma migrate reset",
    "prisma:studio": "doppler run -- prisma studio",
    "prisma:seed": "doppler run -- prisma db seed",
    "tenant:create": "doppler run -- ts-node -r tsconfig-paths/register prisma/scripts/create-tenant.ts",
    "docker:dev": "docker-compose --profile dev up -d",
    "docker:prod": "doppler run -- docker-compose --profile prod up -d",
    "docker:down": "docker-compose down",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^6.10.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "decimal.js": "^10.6.0",
    "flagsmith-nodejs": "^8.1.2",
    "helmet": "^8.1.0",
    "nestjs-pino": "^5.2.0",
    "pg-boss": "~10.4.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.10.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "shallow-equal-object": "^1.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "multer": "^2.3.0",
    "deepmerge-ts": "^8.0.0"
  }
}
