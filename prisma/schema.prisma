// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Roles de la aplicación.
///
/// El modelo es de un rol por usuario, que cubre la mayoría de los casos y se
/// chequea sin joins. Si algún día necesitás varios roles por usuario,
/// reemplazá el campo `User.role` por una tabla intermedia `UserRole`: lo único
/// que hay que tocar además es `UserRepositoryImpl.toDomain()`.
enum Role {
  USER
  ADMIN
}

model User {
  id           String  @id @default(uuid()) @db.VarChar(36)
  email        String  @unique @db.VarChar(255)
  /// Hash bcrypt. La contraseña en texto plano nunca toca la base ni los logs.
  passwordHash String  @db.VarChar(255)
  firstName    String? @db.VarChar(100)
  lastName     String? @db.VarChar(100)
  role         Role    @default(USER)
  isActive     Boolean @default(true)

  /// Bloqueo temporal por intentos fallidos, para frenar fuerza bruta contra
  /// una cuenta puntual (el rate limit por IP no alcanza si el atacante rota IPs).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt       DateTime?
  /// Permite invalidar los access tokens emitidos antes de un cambio de
  /// contraseña cuando `JWT_VALIDATE_USER_ON_REQUEST=true`.
  passwordChangedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete. La extensión de Prisma filtra por `deletedAt: null` sola.
  deletedAt   DateTime?
  createdById String?   @db.VarChar(36)
  updatedById String?   @db.VarChar(36)
  deletedById String?   @db.VarChar(36)

  refreshTokens RefreshToken[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Historial de cambios.
///
/// Una fila por operación, con sólo los campos que cambiaron y sus valores
/// antes y después. Guardar el registro entero haría crecer la tabla sin
/// necesidad y volvería ilegible el diff.
///
/// El JSON de `cambios` no tiene esquema fijo a propósito: cada entidad tiene
/// los suyos y es el front el que decide cómo mostrarlos (formato de moneda,
/// resolver un id a su nombre, etc).
model AuditLog {
  id String @id @default(uuid()) @db.VarChar(36)

  /// Nombre del modelo de Prisma: "User", "Propiedad", ...
  entidad   String      @db.VarChar(64)
  entidadId String      @db.VarChar(64)
  accion    AuditAction

  /// `{ "precio": { "antes": 120000, "despues": 135000 } }`
  /// En un CREATE sólo lleva "despues"; en un DELETE, sólo "antes".
  cambios Json?

  /// Autor del cambio. Null si lo hizo un proceso automático (seed, cron).
  usuarioId    String? @db.VarChar(36)
  usuarioEmail String? @db.VarChar(255)

  /// Permite cruzar el cambio con los logs de la request que lo provocó.
  correlationId String? @db.VarChar(128)
  ip            String? @db.VarChar(45)

  creadoEn DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([creadoEn])
  @@index([correlationId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

/// Refresh tokens con rotación.
///
/// Guardamos el SHA-256 del token, no el token: si se filtra la base, los
/// refresh tokens no son usables. Cada refresh rota el token actual y encadena
/// el nuevo por `familyId`; si alguien reusa un token ya rotado, se revoca toda
/// la familia (señal de robo de token).
model RefreshToken {
  id        String @id @default(uuid()) @db.VarChar(36)
  tokenHash String @unique @db.VarChar(64)

  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Agrupa toda la cadena de rotaciones que nació en un mismo login.
  familyId String @db.VarChar(36)

  expiresAt    DateTime
  revokedAt    DateTime?
  /// Id del token que lo reemplazó al rotar. Sirve para auditar la cadena.
  replacedById String?   @db.VarChar(36)

  userAgent String? @db.VarChar(255)
  ip        String? @db.VarChar(45)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
