// Prisma schema
// Docs: https://pris.ly/d/prisma-schema
//
// Convenciones (spec Fase 1, sección 2 y 12):
// - Modelos y campos en camelCase; tablas y columnas en snake_case vía
//   `@@map` / `@map`.
// - Ids UUID generados por Postgres (`gen_random_uuid()`), fechas `timestamptz`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles de la aplicación (spec Fase 1, sección 4).
///
/// ADMIN y EMPLOYEE operan el backoffice; OWNER y RENTER entran a su portal y
/// además quedan acotados a sus propios datos dentro del tenant (Fase 17/18).
///
/// Un rol por usuario: cubre los casos del PRD y se chequea sin joins.
enum Role {
  ADMIN
  EMPLOYEE
  OWNER
  RENTER
}

enum Currency {
  ARS
  USD
}

/// Inmobiliaria. Raíz del modelo multi-tenant (PRD §5.0).
///
/// Todo lo que cambia de un cliente a otro vive acá y no en el código: los
/// parámetros de negocio arrancan con los defaults del PRD y cada inmobiliaria
/// los ajusta. Alta por seed; sin ABM en el MVP.
///
/// No lleva `tenantId` ni pasa por el filtro de tenant: es la tabla que lo define.
model Tenant {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @db.VarChar(150)
  /// Identificador corto y único ("mi-inmobiliaria"). Para URLs y el seed.
  slug         String  @unique @db.VarChar(60)
  logoUrl      String? @map("logo_url") @db.VarChar(500)
  /// Color de marca en hex. El front lo aplica sobre `--primary`.
  primaryColor String? @map("primary_color") @db.VarChar(9)
  /// Un tenant inactivo no puede loguearse (ninguno de sus usuarios).
  isActive     Boolean @default(true) @map("is_active")

  // ---------------------------------------------------- Parámetros de negocio
  /// Honorarios de administración estándar, en % (PRD: honorarios_pct_estandar).
  standardFeePercentage    Decimal  @default(5) @map("standard_fee_percentage") @db.Decimal(5, 2)
  /// Honorarios reducidos para propietarios con varias propiedades.
  reducedFeePercentage     Decimal  @default(3) @map("reduced_fee_percentage") @db.Decimal(5, 2)
  /// Cantidad de propiedades activas desde la que aplica el honorario reducido.
  reducedFeeThreshold      Int      @default(3) @map("reduced_fee_threshold")
  /// Días del mes sin punitorio (del 1 al N).
  paymentGraceDays         Int      @default(10) @map("payment_grace_days")
  /// Punitorio diario, en %, a partir del día siguiente a la gracia.
  dailyLateFeePercentage   Decimal  @default(5) @map("daily_late_fee_percentage") @db.Decimal(5, 2)
  /// Día del mes en que se generan las cuotas del mes siguiente.
  installmentGenerationDay Int      @default(28) @map("installment_generation_day")
  /// Día del mes en que sale el recordatorio de pago.
  paymentReminderDay       Int      @default(1) @map("payment_reminder_day")
  /// Anticipación, en días, del aviso de vencimiento de contrato.
  contractExpiryNoticeDays Int      @default(60) @map("contract_expiry_notice_days")
  /// Día del mes en que se envía el informe mensual a propietarios.
  monthlyReportDay         Int      @default(10) @map("monthly_report_day")
  defaultCurrency          Currency @default(ARS) @map("default_currency")

  // ---------------------------------------------------- Datos legales (Fase 15)
  /// Razón social, CUIT y contacto: encabezado y pie de los PDFs y datos del
  /// recordatorio de pago. Todos opcionales.
  legalName         String? @map("legal_name") @db.VarChar(200)
  taxId             String? @map("tax_id") @db.VarChar(20)
  address           String? @db.VarChar(250)
  phone             String? @db.VarChar(40)
  email             String? @db.VarChar(255)
  /// Sólo dígitos con código de país (5491122334455): arma el link de WhatsApp.
  whatsapp          String? @db.VarChar(20)
  bankAccountHolder String? @map("bank_account_holder") @db.VarChar(150)
  bankName          String? @map("bank_name") @db.VarChar(100)
  bankCbu           String? @map("bank_cbu") @db.VarChar(22)
  bankAlias         String? @map("bank_alias") @db.VarChar(60)
  /// Leyenda al pie de los PDFs (A-34). Sin valor: se usa la fija.
  documentFooter    String? @map("document_footer") @db.VarChar(500)
  /// Clave del logo en el storage, para borrar el anterior al reemplazarlo.
  logoKey           String? @map("logo_key") @db.VarChar(500)
  /// Último número de recibo emitido; el siguiente es este + 1 (A-33).
  receiptSequence   Int     @default(0) @map("receipt_sequence")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Quién editó la configuración (la auditoría los completa solos).
  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  users     User[]
  asyncJobs AsyncJob[]

  exampleItems      ExampleItem[]
  exampleActivities ExampleActivity[]

  locations      Location[]
  propertyTypes  PropertyType[]
  amenities      Amenity[]
  operationTypes OperationType[]
  serviceTypes   ServiceType[]

  notificationLogs NotificationLog[]
  jobExecutions    JobExecution[]

  generatedDocuments GeneratedDocument[]

  properties     Property[]
  owners         Owner[]
  renters        Renter[]
  guarantors     Guarantor[]
  propertyPhotos PropertyPhoto[]

  contracts            Contract[]
  contractRentUpdates  ContractRentUpdate[]
  contractBillingTerms ContractBillingTerms[]

  propertyServices PropertyService[]
  advanceExpenses  AdvanceExpense[]

  installments            Installment[]
  installmentCharges      InstallmentCharge[]
  payments                Payment[]
  installmentLateFeeDays  InstallmentLateFeeDay[]
  lateFeeAdjustments      LateFeeAdjustment[]
  renterCredits           RenterCredit[]
  depositReturns          DepositReturn[]
  depositReturnDeductions DepositReturnDeduction[]

  settlements           Settlement[]
  settlementPayments    SettlementPayment[]
  settlementExpenses    SettlementExpense[]
  settlementAdjustments SettlementAdjustment[]
  settlementTransfers   SettlementTransfer[]
  ownerStatements       OwnerStatement[]
  ownerStatementTotals  OwnerStatementTotal[]
  feeReceivables        FeeReceivable[]
  feePayments           FeePayment[]
  feePaymentAllocations FeePaymentAllocation[]

  @@map("tenants")
}

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// La unicidad depende de por dónde entra el usuario (Fase 4):
  /// - ADMIN/EMPLOYEE: único en todo el sistema. El login del backoffice es
  ///   email + contraseña y el tenant sale del usuario.
  /// - OWNER/RENTER: único por (tenant, rol). El login de portal recibe la
  ///   inmobiliaria, y la misma persona puede ser propietaria en dos.
  /// Son dos índices únicos parciales (`WHERE role IN ...`) creados a mano en
  /// la migración `scope_user_email_by_audience`: Prisma no los puede declarar
  /// en el schema, pero tampoco los toca al generar migraciones nuevas.
  email        String  @db.VarChar(255)
  /// Hash bcrypt. La contraseña en texto plano nunca toca la base ni los logs.
  passwordHash String  @map("password_hash") @db.VarChar(255)
  firstName    String? @map("first_name") @db.VarChar(100)
  lastName     String? @map("last_name") @db.VarChar(100)
  role         Role
  isActive     Boolean @default(true) @map("is_active")

  /// Bloqueo temporal por intentos fallidos, para frenar fuerza bruta contra
  /// una cuenta puntual (el rate limit por IP no alcanza si el atacante rota IPs).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Permite invalidar los access tokens emitidos antes de un cambio de
  /// contraseña cuando `JWT_VALIDATE_USER_ON_REQUEST=true`.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete. La extensión de Prisma filtra por `deletedAt: null` sola.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Historial de cambios.
///
/// Una fila por operación, con sólo los campos que cambiaron y sus valores
/// antes y después. Guardar el registro entero haría crecer la tabla sin
/// necesidad y volvería ilegible el diff.
///
/// El JSON de `changes` no tiene esquema fijo a propósito: cada entidad tiene
/// los suyos y es el front el que decide cómo mostrarlos (formato de moneda,
/// resolver un id a su nombre, etc).
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Tenant del cambio. Null sólo para procesos sin tenant (seed global).
  tenantId String? @map("tenant_id") @db.Uuid

  /// Nombre del modelo de Prisma: "User", "Property", ...
  entity   String      @db.VarChar(64)
  /// Null en los eventos que no cuelgan de una entidad (login de un email desconocido).
  entityId String?     @map("entity_id") @db.VarChar(64)
  action   AuditAction

  /// `{ "price": { "before": "120000.00", "after": "135000.00" } }`
  /// En un CREATE sólo lleva "after"; en un DELETE, sólo "before".
  changes Json?

  /// Autor del cambio. Null si lo hizo un proceso automático (seed, cron).
  userId    String? @map("user_id") @db.Uuid
  userEmail String? @map("user_email") @db.VarChar(255)

  /// Frase legible (Fase 20). Opcional: si falta, el módulo audit la arma al leer.
  summary   String?        @db.VarChar(300)
  actorKind AuditActorKind @default(USER) @map("actor_kind")

  /// Permite cruzar el cambio con los logs de la request que lo provocó.
  correlationId String? @map("correlation_id") @db.VarChar(128)
  ip            String? @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  NOTIFICATION_SENT
  JOB_RUN
  EXPORT
}

enum AuditActorKind {
  USER
  SYSTEM
  PORTAL_OWNER
  PORTAL_RENTER
}

/// Refresh tokens con rotación.
///
/// Guardamos el SHA-256 del token, no el token: si se filtra la base, los
/// refresh tokens no son usables. Cada refresh rota el token actual y encadena
/// el nuevo por `familyId`; si alguien reusa un token ya rotado, se revoca toda
/// la familia (señal de robo de token).
model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Agrupa toda la cadena de rotaciones que nació en un mismo login.
  familyId String @map("family_id") @db.Uuid

  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Id del token que lo reemplazó al rotar. Sirve para auditar la cadena.
  replacedById String?   @map("replaced_by_id") @db.Uuid

  userAgent String? @map("user_agent") @db.VarChar(255)
  ip        String? @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum AsyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

/// Acción manual pesada que corre en background (spec Fase 1, sección 9.1).
///
/// Una sola tabla para todos los módulos: el que encola un trabajo pesado crea
/// un AsyncJob, lo va actualizando mientras pg-boss procesa los ítems, y el
/// front consulta siempre el mismo endpoint (GET /jobs/:id/status).
model AsyncJob {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Tipo de trabajo, en kebab-case: "payment-reminders", "regenerate-pdfs".
  type   String         @db.VarChar(100)
  status AsyncJobStatus @default(PENDING)

  /// Usuario que lo disparó. Null si lo disparó el sistema (un cron).
  startedById String? @map("started_by_id") @db.Uuid

  /// Null si no se sabe de antemano cuántos ítems hay.
  totalItems     Int? @map("total_items")
  /// Ítems terminados, bien o mal. Los fallidos están incluidos.
  processedItems Int  @default(0) @map("processed_items")
  failedItems    Int  @default(0) @map("failed_items")

  /// Detalle libre según el tipo de trabajo (errores por ítem, links, etc).
  result Json?

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, type, startedAt])
  @@map("async_jobs")
}

// ---------------------------------------------------------------------------
// Módulo de referencia (spec Fase 1). NO se borra: es el patrón que copian las
// fases siguientes. Ver src/modules/_example.
// ---------------------------------------------------------------------------

/// Ítem de ejemplo: una entidad con tenant, dinero, adjunto, auditoría y
/// borrado lógico, que no pertenece a ningún dominio real.
model ExampleItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Único por tenant. Al borrar se muta (ver mutateOnDelete) para liberarlo.
  name  String  @db.VarChar(120)
  /// Dinero: NUMERIC(14,2), nunca float (spec Fase 1, 2.1).
  price Decimal @db.Decimal(14, 2)

  attachmentKey String? @map("attachment_key") @db.VarChar(500)
  attachmentUrl String? @map("attachment_url") @db.VarChar(1000)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("example_items")
}

/// Tabla del segundo módulo de referencia (_example-listener): registra lo que
/// recibe por eventos, sin tocar las tablas de _example.
model ExampleActivity {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Id del ExampleItem. Sin FK a propósito: los módulos no comparten tablas.
  exampleItemId String @map("example_item_id") @db.Uuid
  description   String @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, exampleItemId])
  @@map("example_activities")
}

// ---------------------------------------------------------------------------
// Maestros (Fase 5, PRD 5.8): las listas que alimentan los selectores.
//
// Por inmobiliaria (D-26): cada una administra los suyos. Nacen con un
// catálogo base (prisma/lib/master-data-seed.ts) al darse de alta.
//
// No se borran nunca: `isActive = false` los saca de los selectores pero los
// registros que ya los usan los siguen mostrando.
//
// Nombres únicos sin distinguir mayúsculas: índices únicos sobre
// `lower(name)` creados a mano en la migración `add_master_data` (Prisma no
// declara índices por expresión, pero tampoco los toca).
// ---------------------------------------------------------------------------

enum LocationLevel {
  COUNTRY
  PROVINCE
  CITY
  NEIGHBORHOOD
}

/// Ubicación jerárquica: País → Provincia → Localidad → Barrio.
model Location {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  level    LocationLevel
  name     String        @db.VarChar(120)
  /// Null sólo para un país.
  parentId String?       @map("parent_id") @db.Uuid
  parent   Location?     @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[]    @relation("LocationHierarchy")
  isActive Boolean       @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, parentId])
  @@index([tenantId, level])
  @@map("locations")
}

model PropertyType {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String  @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId])
  @@map("property_types")
}

model Amenity {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String  @db.VarChar(120)
  /// Nombre de ícono de lucide ("waves", "car"). La UI lo resuelve; null = genérico.
  icon     String? @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId])
  @@map("amenities")
}

model OperationType {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String  @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId])
  @@map("operation_types")
}

model ServiceType {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String  @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId])
  @@map("service_types")
}

// ---------------------------------------------------------------------------
// Propiedades (Fase 6, PRD 5.1)
// ---------------------------------------------------------------------------

enum PropertyStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

/// Una propiedad administrada por la inmobiliaria.
///
/// Ubicación, tipo y amenities son ids de los maestros, **sin FK** a propósito:
/// los módulos no comparten tablas (se validan con MasterDataFacade al guardar).
/// Lo mismo el propietario (Fase 7).
model Property {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  address          String         @db.VarChar(200)
  locationId       String         @map("location_id") @db.Uuid
  propertyTypeId   String         @map("property_type_id") @db.Uuid
  status           PropertyStatus @default(AVAILABLE)
  /// Nullable: la propiedad se puede cargar antes que su propietario.
  ownerId          String?        @map("owner_id") @db.Uuid
  amenityIds       String[]       @default([]) @map("amenity_ids") @db.Uuid
  /// Notas internas: nunca se exponen en el portal público.
  notes            String?        @db.Text
  /// Contrato activo (módulo de contratos, sin FK). Lo fija y lo limpia el
  /// módulo de contratos por `PropertiesFacade`; acá sólo se lee (D-51).
  activeContractId String?        @map("active_contract_id") @db.Uuid
  /// Último contrato que tuvo, activo o no. Nunca se limpia: es el "historial
  /// de contratos" que bloquea el borrado (spec Fase 6, 3.8).
  lastContractId   String?        @map("last_contract_id") @db.Uuid

  photos PropertyPhoto[]

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@index([tenantId, activeContractId])
  @@index([tenantId, propertyTypeId])
  @@index([tenantId, deletedAt])
  /// Búsqueda por dirección parcial (ILIKE): trigramas. La extensión pg_trgm
  /// la crea la migración `add_properties`.
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_address_trgm_idx")
  @@map("properties")
}

/// Foto de una propiedad. Tabla aparte (y no un array de URLs) para poder
/// borrar una por id, ordenarlas y guardar la `key` del storage para borrarla.
model PropertyPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  storageKey String @map("storage_key") @db.VarChar(500)
  url        String @db.VarChar(1000)
  /// Orden en el carrusel; la de menor posición es la principal.
  position   Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, propertyId, position])
  @@map("property_photos")
}

// ---------------------------------------------------------------------------
// Propietarios (Fase 7, PRD 5.2)
// ---------------------------------------------------------------------------

/// Dueño de una o más propiedades administradas.
///
/// Sus credenciales de portal NO viven acá: son un usuario OWNER del módulo de
/// auth (D-16), enlazado por `portalUserId` (sin FK: módulos distintos).
model Owner {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  /// DNI o CUIT, sólo dígitos. Único por inmobiliaria entre los no borrados
  /// (índice parcial en la migración `add_owners`).
  nationalId String  @map("national_id") @db.VarChar(11)
  /// Nombre y apellido en minúsculas y sin acentos, para buscar "perez" y
  /// encontrar "Pérez". Lo calcula la app al guardar.
  searchName String  @map("search_name") @db.VarChar(201)
  phone      String? @db.VarChar(40)
  email      String? @db.VarChar(255)
  address    String? @db.VarChar(200)
  notes      String? @db.Text

  // Datos bancarios: columnas propias y no un JSON, así cada cambio queda en
  // la auditoría campo por campo (un cambio de CBU es una acción de riesgo).
  bankCbu    String? @map("bank_cbu") @db.VarChar(22)
  bankAlias  String? @map("bank_alias") @db.VarChar(50)
  bankName   String? @map("bank_name") @db.VarChar(100)
  bankHolder String? @map("bank_holder") @db.VarChar(150)

  portalUserId String? @map("portal_user_id") @db.Uuid

  // Honorarios y envíos (Fase 12, 2.1; Micaela #5 y #7). El % es un override
  // de la regla por umbral del tenant (null = la regla); los booleanos dicen
  // qué conceptos cobrados entran en la base además del alquiler.
  feePercentage       Decimal?          @map("fee_percentage") @db.Decimal(5, 2)
  feeIncludesLateFees Boolean           @default(false) @map("fee_includes_late_fees")
  feeIncludesCharges  Boolean           @default(false) @map("fee_includes_charges")
  statementSendMode   StatementSendMode @default(BOTH) @map("statement_send_mode")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, bankCbu])
  @@index([tenantId, deletedAt])
  @@map("owners")
}

/// Qué se le manda al propietario al cerrar el consolidado mensual (Micaela
/// #7): sólo el resumen, sólo los comprobantes de cada liquidación, o ambos.
enum StatementSendMode {
  SUMMARY
  RECEIPTS
  BOTH
}

/// Con qué responde el garante (PRD 5.4): un inmueble propio o sus recibos de
/// sueldo. El detalle es texto libre en el MVP.
enum GuaranteeType {
  PROPERTY
  PAYSLIPS
}

/// Garante de un inquilino (PRD 5.4, Fase 8). Vive en el módulo de
/// inquilinos: no existe sin ellos. Una misma persona puede garantizar a
/// varios inquilinos.
model Guarantor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  firstName  String  @map("first_name") @db.VarChar(100)
  lastName   String  @map("last_name") @db.VarChar(100)
  /// DNI o CUIT, sólo dígitos. Único por inmobiliaria entre los no borrados
  /// (índice parcial en la migración `add_renters`).
  nationalId String  @map("national_id") @db.VarChar(11)
  /// Nombre y apellido en minúsculas y sin acentos (ver `Owner.searchName`).
  searchName String  @map("search_name") @db.VarChar(201)
  phone      String? @db.VarChar(40)
  email      String? @db.VarChar(255)
  address    String? @db.VarChar(200)

  guaranteeType   GuaranteeType @map("guarantee_type")
  /// Dirección y datos registrales del inmueble, o empleador y sueldo
  /// aproximado. Texto libre, nunca vacío.
  guaranteeDetail String        @map("guarantee_detail") @db.Text
  notes           String?       @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  renters Renter[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, deletedAt])
  @@map("guarantors")
}

/// Inquilino (PRD 5.3, Fase 8). Un solo garante a la vez, con FK real: las
/// dos tablas son del mismo módulo. `portalUserId` apunta a `users` sin FK
/// (módulo de auth), igual que en `Owner`.
model Renter {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  /// DNI o CUIT, sólo dígitos. Único por inmobiliaria entre los no borrados
  /// (índice parcial en la migración `add_renters`).
  nationalId String    @map("national_id") @db.VarChar(11)
  /// Nombre y apellido en minúsculas y sin acentos (ver `Owner.searchName`).
  searchName String    @map("search_name") @db.VarChar(201)
  phone      String?   @db.VarChar(40)
  email      String?   @db.VarChar(255)
  address    String?   @db.VarChar(200)
  /// Fecha (sin hora) en que entró a vivir. Opcional: muchos se cargan antes.
  moveInDate DateTime? @map("move_in_date") @db.Date
  notes      String?   @db.Text

  guarantorId String?    @map("guarantor_id") @db.Uuid
  guarantor   Guarantor? @relation(fields: [guarantorId], references: [id], onDelete: Restrict)

  portalUserId String? @map("portal_user_id") @db.Uuid

  /// Contrato activo del que es titular (módulo de contratos, sin FK). Lo
  /// fija y lo limpia el módulo de contratos por `RentersFacade` (D-51).
  activeContractId String? @map("active_contract_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, guarantorId])
  @@index([tenantId, deletedAt])
  @@map("renters")
}

// ---------------------------------------------------------------------------
// Índices de actualización de alquileres (Fase 9; la Fase 13 los carga sola)
// ---------------------------------------------------------------------------

enum IndexType {
  ICL
  IPC
}

/// Valor mensual de un índice público (ICL del BCRA, IPC del INDEC).
///
/// **Global, sin `tenantId`**: el índice es el mismo para todas las
/// inmobiliarias (D-54). Hoy se carga a mano por `POST /indices`; la Fase 13
/// lo trae de la fuente oficial y deja `source` con el nombre de la fuente.
model IndexValue {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indexType IndexType @map("index_type")
  /// Mes al que corresponde el valor, `AAAA-MM`.
  period    String    @db.VarChar(7)
  /// Decimal(14,6): el ICL se publica con varios decimales.
  value     Decimal   @db.Decimal(14, 6)
  /// De dónde salió: `manual`, `bcra`, `indec`...
  source    String    @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([indexType, period])
  @@map("index_values")
}

// ---------------------------------------------------------------------------
// Contratos de alquiler (Fase 9, PRD 5.5)
// ---------------------------------------------------------------------------

/// Cómo se actualiza el alquiler (PRD 5.5: ICL / IPC / Fijo / Otro).
enum RentUpdateType {
  ICL
  IPC
  FIXED
  OTHER
}

/// Cada cuántos meses se actualiza (PRD 5.5: mensual / trimestral / cuatrimestral).
enum RentUpdateFrequency {
  MONTHLY
  QUARTERLY
  FOUR_MONTHLY
  SEMIANNUAL
  ANNUAL
}

/// Cómo se devuelve el depósito al terminar el contrato (Micaela #1).
enum DepositReturnMode {
  /// Se devuelve lo que se recibió.
  FIXED
  /// Se devuelve el equivalente al alquiler vigente al terminar.
  FOLLOWS_RENT
  /// El monto se define a mano al cerrar las cuentas.
  MANUAL
}

/// Quién cobra el alquiler (Micaela #9).
enum CollectionMode {
  AGENCY
  OWNER_DIRECT
}

/// Cómo cobra sus honorarios la inmobiliaria (Micaela #10).
enum FeeMode {
  /// Los descuenta de lo cobrado al liquidar.
  DEDUCTED
  /// El propietario los paga después.
  OWNER_PAYS
  /// El inquilino los paga aparte, por cuenta del propietario.
  RENTER_PAYS_ON_BEHALF
}

enum ContractStatus {
  ACTIVE
  FINISHED
  TERMINATED
}

/// De dónde salió cada valor del alquiler.
enum RentUpdateSource {
  /// El canon inicial, al crear el contrato.
  INITIAL
  /// Un aumento por índice (ICL/IPC), con los valores usados.
  INDEX
  /// Un aumento cargado a mano (contratos "Fijo"/"Otro").
  MANUAL
}

/// Contrato de alquiler (PRD 5.5).
///
/// Propiedad, propietario, inquilino y garante son ids de otros módulos,
/// **sin FK** (se validan por las facades). Nunca se borra: un contrato
/// finalizado o rescindido es historial. El alquiler vigente no está acá:
/// es la última fila de `contract_rent_updates` (D-53). Los servicios del
/// contrato son de la Fase 10 (`property_services.contract_id`).
model Contract {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  propertyId  String  @map("property_id") @db.Uuid
  /// Copiado del propietario de la propiedad al crear el contrato.
  ownerId     String  @map("owner_id") @db.Uuid
  renterId    String  @map("renter_id") @db.Uuid
  guarantorId String? @map("guarantor_id") @db.Uuid

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  initialRent             Decimal             @map("initial_rent") @db.Decimal(14, 2)
  currency                Currency
  rentUpdateType          RentUpdateType      @map("rent_update_type")
  rentUpdateFrequency     RentUpdateFrequency @map("rent_update_frequency")
  /// Depósito en garantía, por el importe y la moneda recibidos (Micaela #1).
  deposit                 Decimal             @db.Decimal(14, 2)
  depositCurrency         Currency            @map("deposit_currency")
  depositReturnMode       DepositReturnMode   @default(FIXED) @map("deposit_return_mode")
  /// Con `rentUpdateType = FIXED`, el % que se aplica solo en cada aumento.
  fixedIncreasePercentage Decimal?            @map("fixed_increase_percentage") @db.Decimal(5, 2)
  /// Honorarios de administración, en %, fijados al crear (spec Fase 9, 4).
  /// El vigente sale de `contract_billing_terms` (D-70).
  feePercentage           Decimal             @map("fee_percentage") @db.Decimal(5, 2)

  status ContractStatus @default(ACTIVE)

  contractPdfKey String? @map("contract_pdf_key") @db.VarChar(500)
  contractPdfUrl String? @map("contract_pdf_url") @db.VarChar(1000)
  notes          String? @db.Text

  // Seguro de caución (PRD 5.5)
  hasSurety         Boolean   @default(false) @map("has_surety")
  insurerName       String?   @map("insurer_name") @db.VarChar(150)
  /// Obligatorio con caución: ahí va la alerta automática (RN-10).
  insurerAlertEmail String?   @map("insurer_alert_email") @db.VarChar(255)
  policyNumber      String?   @map("policy_number") @db.VarChar(100)
  policyExpiresAt   DateTime? @map("policy_expires_at") @db.Date
  policyPdfKey      String?   @map("policy_pdf_key") @db.VarChar(500)
  policyPdfUrl      String?   @map("policy_pdf_url") @db.VarChar(1000)

  // Rescisión anticipada (RN-09). Se completan al rescindir y no cambian más.
  terminatedAt          DateTime? @map("terminated_at") @db.Date
  terminationNotifiedAt DateTime? @map("termination_notified_at") @db.Date
  terminationPenalty    Decimal?  @map("termination_penalty") @db.Decimal(14, 2)
  terminationFutureRent Decimal?  @map("termination_future_rent") @db.Decimal(14, 2)
  /// PDF del cálculo de la rescisión (Fase 15); lo escribe `documents`.
  terminationPdfKey     String?   @map("termination_pdf_key") @db.VarChar(500)
  terminationPdfUrl     String?   @map("termination_pdf_url") @db.VarChar(1000)

  /// Contrato al que renueva (sin FK: autorreferencia que no hace falta navegar).
  renewedFromId String? @map("renewed_from_id") @db.Uuid

  rentUpdates  ContractRentUpdate[]
  billingTerms ContractBillingTerms[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  /// Un solo contrato ACTIVO por propiedad (RN-04) y por inquilino (RN-05):
  /// índices únicos parciales en la migración `add_contracts`.
  @@index([tenantId, status, endDate])
  @@index([tenantId, propertyId])
  @@index([tenantId, renterId])
  @@index([tenantId, ownerId])
  @@map("contracts")
}

/// Historial del alquiler de un contrato. La primera fila es el canon
/// inicial; cada aumento agrega una. El vigente es la de mayor
/// `effective_from` (D-53). Con índice, guarda los valores usados para poder
/// reconstruir la cuenta (PRD 9.5).
model ContractRentUpdate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  effectiveFrom DateTime         @map("effective_from") @db.Date
  previousRent  Decimal?         @map("previous_rent") @db.Decimal(14, 2)
  newRent       Decimal          @map("new_rent") @db.Decimal(14, 2)
  source        RentUpdateSource

  indexType       IndexType? @map("index_type")
  /// `AAAA-MM` del valor anterior y del nuevo.
  indexFromPeriod String?    @map("index_from_period") @db.VarChar(7)
  indexToPeriod   String?    @map("index_to_period") @db.VarChar(7)
  indexFromValue  Decimal?   @map("index_from_value") @db.Decimal(14, 6)
  indexToValue    Decimal?   @map("index_to_value") @db.Decimal(14, 6)

  /// % fijo aplicado (contratos FIXED con `fixedIncreasePercentage`).
  fixedPercentage Decimal? @map("fixed_percentage") @db.Decimal(5, 2)

  /// Usuario que lo aplicó. Null si lo aplicó el cron (Fase 13).
  appliedById String? @map("applied_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, contractId, effectiveFrom])
  @@map("contract_rent_updates")
}

/// Términos de cobro de un contrato, como vigencias (D-70): nunca se pisan,
/// cada cambio es una fila nueva con `effectiveFrom`. La primera nace con el
/// contrato. El punitorio null hereda el del tenant.
model ContractBillingTerms {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  effectiveFrom     DateTime       @map("effective_from") @db.Date
  collectionMode    CollectionMode @map("collection_mode")
  feeMode           FeeMode        @map("fee_mode")
  /// % de honorarios vigente.
  feePercentage     Decimal        @map("fee_percentage") @db.Decimal(5, 2)
  /// Importe fijo de honorarios; si está, manda sobre el %.
  feeAmount         Decimal?       @map("fee_amount") @db.Decimal(14, 2)
  /// Null = el de la inmobiliaria (`daily_late_fee_percentage`).
  lateFeePercentage Decimal?       @map("late_fee_percentage") @db.Decimal(5, 2)
  /// Null = el de la inmobiliaria (`payment_grace_days`).
  lateFeeGraceDays  Int?           @map("late_fee_grace_days")
  notes             String?        @db.Text
  /// Null en la fila inicial (la crea el alta del contrato).
  changedById       String?        @map("changed_by_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, contractId, effectiveFrom])
  @@map("contract_billing_terms")
}

// =============================================================================
// Servicios y gastos adelantados (Fase 10)
// =============================================================================

/// Quién paga un servicio (spec Fase 10, 2.1: inquilino / propietario).
enum ServicePayer {
  RENTER
  OWNER
}

/// Un servicio asociado a una propiedad (luz, gas, expensas...) y, si lo hay,
/// al contrato. Sin `contract_id` es un servicio "de la propiedad", que los
/// contratos heredan (D-66). Las referencias no llevan FK: se validan por las
/// facades de propiedades, contratos y maestros. El estado (al día / vencido)
/// no se guarda: se calcula al leer con `due_date` (spec 4, D-64).
model PropertyService {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  propertyId    String  @map("property_id") @db.Uuid
  contractId    String? @map("contract_id") @db.Uuid
  serviceTypeId String  @map("service_type_id") @db.Uuid

  paidBy   ServicePayer @map("paid_by")
  currency Currency

  hasDueDate        Boolean              @default(false) @map("has_due_date")
  dueDate           DateTime?            @map("due_date") @db.Date
  hasIncrease       Boolean              @default(false) @map("has_increase")
  /// Misma escala que los aumentos del alquiler (mensual / trimestral / cuatrimestral).
  increaseFrequency RentUpdateFrequency? @map("increase_frequency")
  /// Si la inmobiliaria gestiona el pago o es sólo informativo (spec 7).
  managedByAgency   Boolean              @default(false) @map("managed_by_agency")
  notes             String?              @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId, propertyId])
  @@index([tenantId, contractId])
  @@index([tenantId, hasDueDate, dueDate])
  @@index([tenantId, deletedAt])
  @@map("property_services")
}

/// Gasto que el inquilino adelantó (una reparación, un servicio) y que se le
/// descuenta al propietario en la liquidación (RN-11). El comprobante es
/// obligatorio (D-67). Con `settlement_id` cargado (Fase 12) la fila es
/// inmutable (spec 4).
model AdvanceExpense {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  contractId String @map("contract_id") @db.Uuid
  /// Copiado del contrato al registrar el gasto.
  renterId   String @map("renter_id") @db.Uuid

  amount      Decimal  @db.Decimal(14, 2)
  currency    Currency
  description String   @db.VarChar(300)
  expenseDate DateTime @map("expense_date") @db.Date

  receiptKey String @map("receipt_key") @db.VarChar(500)
  receiptUrl String @map("receipt_url") @db.VarChar(1000)

  /// Liquidación que lo descontó (Fase 12, sin FK). Null = pendiente.
  settlementId String?   @map("settlement_id") @db.Uuid
  settledAt    DateTime? @map("settled_at") @db.Timestamptz(3)

  /// Usuario que lo cargó.
  registeredById String @map("registered_by_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@index([tenantId, contractId, settlementId])
  @@index([tenantId, deletedAt])
  @@map("advance_expenses")
}

// =============================================================================
// Cobros y punitorios (Fase 11, rediseño sección 3)
// =============================================================================
//
// Todo con tenant, auditado y sin borrado lógico: plata nunca se borra, se
// anula con registro. Sin FKs hacia otros módulos (contrato, inquilino,
// propietario, propiedad y usuario son uuid copiados); FKs internas entre
// cuotas, pagos, cargos, ajustes y detalle diario.

/// Estado guardado de una cuota. "Vencida" (OVERDUE) se calcula al leer (D-71).
enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
}

/// Conceptos que se cobran además del alquiler.
enum ChargeConcept {
  SERVICE
  TERMINATION_PENALTY
  OTHER
}

enum ExchangeRateSource {
  OFFICIAL
  MEP
  OTHER
}

enum PaymentKind {
  /// Entró plata.
  CASH_IN
  /// Se aplicó un saldo a favor: no entra plata.
  CREDIT_APPLICATION
}

enum PaymentMethod {
  TRANSFER
  CASH
  CREDIT
  OTHER
  /// Deuda cubierta con el depósito en garantía al devolverlo (Fase 12).
  DEPOSIT
}

/// Por qué se descuenta algo del depósito al devolverlo (Micaela #1).
enum DepositDeductionConcept {
  /// Deuda del inquilino; con cuota, crea un pago `DEPOSIT` sobre ella.
  DEBT
  DAMAGE
  OTHER
}

enum PaymentReceiver {
  AGENCY
  OWNER
}

enum PaymentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  VOIDED
}

enum LateFeeAdjustmentKind {
  REDUCE
  WAIVE
}

enum CreditStatus {
  AVAILABLE
  APPLIED
  REFUNDED
  VOIDED
}

/// Cuota devengada: una por contrato y mes (PRD 5.6 "Pago").
model Installment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Copiados del contrato al generar (sin FK).
  contractId String @map("contract_id") @db.Uuid
  renterId   String @map("renter_id") @db.Uuid
  ownerId    String @map("owner_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  /// `AAAA-MM`.
  period       String   @db.VarChar(7)
  /// Alquiler vigente al generar (D-72).
  baseAmount   Decimal  @map("base_amount") @db.Decimal(14, 2)
  currency     Currency
  /// Último día sin punitorio: primer día + gracia − 1.
  graceEndDate DateTime @map("grace_end_date") @db.Date

  /// Snapshot de los términos resueltos al generar (D-71): cambiar el
  /// contrato afecta cuotas futuras, no esta.
  lateFeePercentage Decimal        @map("late_fee_percentage") @db.Decimal(5, 2)
  lateFeeGraceDays  Int            @map("late_fee_grace_days")
  collectionMode    CollectionMode @map("collection_mode")
  feeMode           FeeMode        @map("fee_mode")
  feePercentage     Decimal        @map("fee_percentage") @db.Decimal(5, 2)
  feeAmount         Decimal?       @map("fee_amount") @db.Decimal(14, 2)

  /// Condonación total del punitorio (ajuste WAIVE).
  lateFeeWaived Boolean           @default(false) @map("late_fee_waived")
  status        InstallmentStatus @default(PENDING)
  /// Día en que el saldo de alquiler llegó a 0 (fecha del pago que lo cubrió).
  paidAt        DateTime?         @map("paid_at") @db.Date
  notes         String?           @db.Text

  charges     InstallmentCharge[]
  payments    Payment[]
  feeDays     InstallmentLateFeeDay[]
  adjustments LateFeeAdjustment[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([tenantId, contractId, period])
  @@index([tenantId, period, status])
  @@index([tenantId, status, graceEndDate])
  @@index([tenantId, renterId, status])
  @@index([tenantId, propertyId])
  @@index([tenantId, ownerId])
  @@map("installments")
}

/// Un concepto además del alquiler (expensas, multa de rescisión, otro). Se
/// anula, no se borra; anulado no cuenta. No devenga punitorio (A-10).
model InstallmentCharge {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  installmentId String      @map("installment_id") @db.Uuid
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  concept     ChargeConcept
  description String        @db.VarChar(300)
  /// > 0, en la moneda de la cuota.
  amount      Decimal       @db.Decimal(14, 2)

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Quién lo cargó (lo completa la auditoría).
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, installmentId])
  @@map("installment_charges")
}

/// Un pago (o una aplicación de saldo a favor) sobre una cuota. N por cuota:
/// parciales, anticipados, en ARS o USD con cotización (Micaela #2, #6).
model Payment {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  installmentId String      @map("installment_id") @db.Uuid
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  /// Copiados de la cuota.
  contractId    String      @map("contract_id") @db.Uuid
  renterId      String      @map("renter_id") @db.Uuid

  /// Fecha real del pago (no la de carga).
  paidAt       DateTime @map("paid_at") @db.Date
  paidCurrency Currency @map("paid_currency")
  /// Lo que entregó el inquilino, en `paidCurrency`.
  amount       Decimal  @db.Decimal(14, 2)

  /// Obligatorios los tres cuando la moneda del pago no es la de la cuota
  /// (A-9); prohibidos cuando coinciden. Pesos por 1 dólar.
  exchangeRate             Decimal?            @map("exchange_rate") @db.Decimal(14, 4)
  exchangeRateSource       ExchangeRateSource? @map("exchange_rate_source")
  exchangeRateDate         DateTime?           @map("exchange_rate_date") @db.Date
  /// El equivalente en la moneda de la cuota, con un solo redondeo.
  amountInContractCurrency Decimal             @map("amount_in_contract_currency") @db.Decimal(14, 2)

  kind       PaymentKind
  method     PaymentMethod
  receivedBy PaymentReceiver @map("received_by")
  status     PaymentStatus

  /// Imputación en moneda del contrato (A-8). Suman
  /// `amountInContractCurrency − creditGenerated`.
  lateFeeApplied  Decimal @map("late_fee_applied") @db.Decimal(14, 2)
  rentApplied     Decimal @map("rent_applied") @db.Decimal(14, 2)
  chargesApplied  Decimal @map("charges_applied") @db.Decimal(14, 2)
  /// Exceso que fue a `renter_credits` (A-6).
  creditGenerated Decimal @map("credit_generated") @db.Decimal(14, 2)
  /// El crédito aplicado (sólo CREDIT_APPLICATION).
  creditId        String? @map("credit_id") @db.Uuid

  /// Comprobante opcional (D-74): efectivo puede no tener.
  receiptKey String? @map("receipt_key") @db.VarChar(500)
  receiptUrl String? @map("receipt_url") @db.VarChar(1000)

  /// Recibo que emite la inmobiliaria (Fase 15): número correlativo del
  /// tenant (`R-00000042`) y PDF vigente. Los escribe `documents` por la facade.
  receiptNumber     String? @map("receipt_number") @db.VarChar(20)
  receiptPdfKey     String? @map("receipt_pdf_key") @db.VarChar(500)
  receiptPdfUrl     String? @map("receipt_pdf_url") @db.VarChar(1000)

  registeredById String  @map("registered_by_id") @db.Uuid
  notes          String? @db.Text

  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)

  voidedById String?   @map("voided_by_id") @db.Uuid
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidReason String?   @map("void_reason") @db.VarChar(500)

  /// Liquidación que lo incluyó (Fase 12, sin FK: lo escribe liquidaciones
  /// por la facade). Null = todavía no se liquidó.
  settlementId String? @map("settlement_id") @db.Uuid

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, installmentId])
  @@index([tenantId, contractId, paidAt])
  @@index([tenantId, renterId])
  @@index([tenantId, status, receivedBy])
  @@index([tenantId, creditId])
  @@index([tenantId, settlementId])
  @@unique([tenantId, receiptNumber])
  @@map("payments")
}

/// Devolución del depósito en garantía al cerrar las cuentas del contrato
/// (Fase 12, 2.2; Micaela #1): cuánto se devolvió y qué se descontó, con
/// justificación. Una por contrato. `returned_amount + Σ deducciones =
/// deposit_amount`.
model DepositReturn {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  contractId String @map("contract_id") @db.Uuid

  returnedAt      DateTime      @map("returned_at") @db.Date
  /// Copiados del contrato al devolver.
  depositAmount   Decimal       @map("deposit_amount") @db.Decimal(14, 2)
  depositCurrency Currency      @map("deposit_currency")
  returnedAmount  Decimal       @map("returned_amount") @db.Decimal(14, 2)
  method          PaymentMethod
  notes           String?       @db.Text
  registeredById  String        @map("registered_by_id") @db.Uuid

  deductions DepositReturnDeduction[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([tenantId, contractId])
  @@map("deposit_returns")
}

model DepositReturnDeduction {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  depositReturnId String        @map("deposit_return_id") @db.Uuid
  depositReturn   DepositReturn @relation(fields: [depositReturnId], references: [id], onDelete: Cascade)

  concept       DepositDeductionConcept
  description   String                  @db.VarChar(300)
  amount        Decimal                 @db.Decimal(14, 2)
  /// Cuota a la que se imputó una deuda (sin FK).
  installmentId String?                 @map("installment_id") @db.Uuid
  /// El pago `DEPOSIT` que se creó sobre esa cuota.
  paymentId     String?                 @map("payment_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, depositReturnId])
  @@map("deposit_return_deductions")
}

/// Un día de punitorio de una cuota saldada: cómo se armó el monto (A-4). Se
/// escribe cuando el alquiler queda saldado (congela el cálculo); mientras
/// está impaga se calcula al leer.
model InstallmentLateFeeDay {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  installmentId String      @map("installment_id") @db.Uuid
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  day             DateTime @db.Date
  /// 1 = primer día con punitorio.
  dayNumber       Int      @map("day_number")
  /// Alquiler impago ese día.
  outstandingBase Decimal  @map("outstanding_base") @db.Decimal(14, 2)
  dailyPercentage Decimal  @map("daily_percentage") @db.Decimal(5, 2)
  amount          Decimal  @db.Decimal(14, 2)

  @@unique([installmentId, dayNumber])
  @@index([tenantId, installmentId])
  @@map("installment_late_fee_days")
}

/// Reducción o condonación del punitorio de una cuota, con motivo (Micaela #4).
model LateFeeAdjustment {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  installmentId String      @map("installment_id") @db.Uuid
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  kind   LateFeeAdjustmentKind
  /// REDUCE: lo que se descuenta (> 0). WAIVE: el devengado al momento, informativo.
  amount Decimal               @db.Decimal(14, 2)
  reason String                @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Quién lo hizo (lo completa la auditoría).
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, installmentId])
  @@map("late_fee_adjustments")
}

/// Saldo a favor de un inquilino por un pago de más (A-6). Se aplica en partes
/// (cada aplicación es un Payment CREDIT_APPLICATION) o se devuelve.
model RenterCredit {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  renterId        String       @map("renter_id") @db.Uuid
  contractId      String       @map("contract_id") @db.Uuid
  currency        Currency
  /// Original.
  amount          Decimal      @db.Decimal(14, 2)
  remaining       Decimal      @db.Decimal(14, 2)
  /// El pago que lo generó.
  originPaymentId String       @map("origin_payment_id") @db.Uuid
  status          CreditStatus @default(AVAILABLE)

  refundedAt   DateTime?      @map("refunded_at") @db.Date
  refundMethod PaymentMethod? @map("refund_method")
  refundedById String?        @map("refunded_by_id") @db.Uuid
  refundNotes  String?        @map("refund_notes") @db.Text

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, renterId, status])
  @@index([tenantId, contractId])
  @@index([tenantId, originPaymentId])
  @@map("renter_credits")
}

// =============================================================================
// Liquidaciones (Fase 12, rediseño sección 3). Todas con tenant, auditadas,
// sin borrado lógico. Referencias a otros módulos como uuid sin FK.
// =============================================================================

enum SettlementStatus {
  /// Recalculable; una sola por contrato.
  PENDING
  /// Inmutable: pagos y gastos marcados, honorarios devengados.
  CONFIRMED
  /// Las transferencias cubren el neto.
  TRANSFERRED
  /// Sólo desde PENDING (admin).
  CANCELLED
}

/// Rubros manuales de la liquidación (A-20). Los tres primeros restan del
/// neto; OTHER_CREDIT suma.
enum SettlementAdjustmentConcept {
  WITHHOLDING
  OWNER_ADVANCE
  OTHER_DEDUCTION
  OTHER_CREDIT
}

enum StatementStatus {
  OPEN
  CLOSED
}

/// De dónde nace un honorario a cobrar: el propietario cobró el alquiler
/// directo (modalidad B), o la liquidación no lo descontó (OWNER_PAYS /
/// RENTER_PAYS_ON_BEHALF).
enum FeeReceivableSource {
  OWNER_DIRECT_PAYMENT
  SETTLEMENT_NOT_DEDUCTED
}

enum FeePayer {
  OWNER
  RENTER
}

enum FeeReceivableStatus {
  PENDING
  PARTIAL
  PAID
  VOIDED
}

/// Liquidación individual: un contrato, una propiedad, un propietario (3.1).
/// `period` es el mes en que se liquida, no el de la cuota; `sequence`
/// numera las parciales del mismo mes.
model Settlement {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Copiados del contrato (sin FK).
  contractId String   @map("contract_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  renterId   String   @map("renter_id") @db.Uuid
  currency   Currency

  period   String           @db.VarChar(7)
  sequence Int
  status   SettlementStatus @default(PENDING)

  /// Sumas de los pagos incluidos, en la moneda del contrato.
  rentTotal           Decimal @map("rent_total") @db.Decimal(14, 2)
  lateFeeTotal        Decimal @map("late_fee_total") @db.Decimal(14, 2)
  /// Cargos TERMINATION_PENALTY y OTHER: van al propietario.
  ownerChargesTotal   Decimal @map("owner_charges_total") @db.Decimal(14, 2)
  /// Cargos SERVICE: se informan, no entran al neto (A-16).
  serviceChargesTotal Decimal @map("service_charges_total") @db.Decimal(14, 2)

  /// Honorarios (4.2): base según el propietario, % y fijo de la cuota más
  /// reciente, total sumado por cuota, y si se descuentan del neto.
  feeBase        Decimal  @map("fee_base") @db.Decimal(14, 2)
  feePercentage  Decimal  @map("fee_percentage") @db.Decimal(5, 2)
  feeAmountFixed Decimal? @map("fee_amount_fixed") @db.Decimal(14, 2)
  feeTotal       Decimal  @map("fee_total") @db.Decimal(14, 2)
  feeMode        FeeMode  @map("fee_mode")
  feeDeducted    Boolean  @map("fee_deducted")
  /// Las cuotas incluidas tenían términos distintos.
  mixedFeeTerms  Boolean  @default(false) @map("mixed_fee_terms")

  /// Gastos adelantados pendientes en la moneda del contrato (RN-11).
  expensesTotal    Decimal @map("expenses_total") @db.Decimal(14, 2)
  /// Σ ajustes vigentes con signo.
  adjustmentsTotal Decimal @map("adjustments_total") @db.Decimal(14, 2)
  /// Puede ser negativo: el propietario debe (4.3).
  netAmount        Decimal @map("net_amount") @db.Decimal(14, 2)
  transferredTotal Decimal @map("transferred_total") @db.Decimal(14, 2)

  /// Consolidado al que pertenece (sin FK).
  statementId       String? @map("statement_id") @db.Uuid
  /// Un pago incluido se anuló después de confirmar (A-19).
  hasVoidedPayments Boolean @default(false) @map("has_voided_payments")

  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?   @map("cancelled_by_id") @db.Uuid
  cancelReason  String?   @map("cancel_reason") @db.VarChar(500)
  notes         String?   @db.Text

  /// El propietario acusó recibo de la transferencia desde el portal (A-37).
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  /// PDF vigente de la liquidación (Fase 15); lo escribe `documents`.
  pdfKey String? @map("pdf_key") @db.VarChar(500)
  pdfUrl String? @map("pdf_url") @db.VarChar(1000)

  payments    SettlementPayment[]
  expenses    SettlementExpense[]
  adjustments SettlementAdjustment[]
  transfers   SettlementTransfer[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  /// Una sola PENDING por contrato: índice único parcial en la migración
  /// `add_settlements`.
  @@index([tenantId, contractId, period])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, propertyId])
  @@index([tenantId, status, period])
  @@index([tenantId, statementId])
  @@map("settlements")
}

/// Un pago incluido, con snapshot de lo que aportó. `payment_id` es único:
/// un pago se liquida una vez (al cancelar la liquidación se liberan).
model SettlementPayment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  paymentId             String   @map("payment_id") @db.Uuid
  installmentId         String   @map("installment_id") @db.Uuid
  installmentPeriod     String   @map("installment_period") @db.VarChar(7)
  paidAt                DateTime @map("paid_at") @db.Date
  rentApplied           Decimal  @map("rent_applied") @db.Decimal(14, 2)
  lateFeeApplied        Decimal  @map("late_fee_applied") @db.Decimal(14, 2)
  ownerChargesApplied   Decimal  @map("owner_charges_applied") @db.Decimal(14, 2)
  serviceChargesApplied Decimal  @map("service_charges_applied") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, paymentId])
  @@index([tenantId, settlementId])
  @@map("settlement_payments")
}

/// Un gasto adelantado descontado, con snapshot.
model SettlementExpense {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  expenseId   String   @map("expense_id") @db.Uuid
  description String   @db.VarChar(300)
  expenseDate DateTime @map("expense_date") @db.Date
  amount      Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, expenseId])
  @@index([tenantId, settlementId])
  @@map("settlement_expenses")
}

/// Retenciones, adelantos y otros rubros manuales (A-20), más la deducción
/// automática por un pago anulado después de confirmar (A-19).
model SettlementAdjustment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  concept         SettlementAdjustmentConcept
  description     String                      @db.VarChar(300)
  /// Siempre > 0; el signo lo da el concepto.
  amount          Decimal                     @db.Decimal(14, 2)
  /// El pago anulado que lo generó (idempotencia del listener).
  originPaymentId String?                     @map("origin_payment_id") @db.Uuid

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Null en los automáticos.
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, settlementId])
  @@index([tenantId, originPaymentId])
  @@map("settlement_adjustments")
}

/// Transferencia al propietario (4.5). Se anula (admin), no se edita (A-18).
model SettlementTransfer {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  settlementId String     @map("settlement_id") @db.Uuid
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  transferredAt  DateTime      @map("transferred_at") @db.Date
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  receiptKey     String?       @map("receipt_key") @db.VarChar(500)
  receiptUrl     String?       @map("receipt_url") @db.VarChar(1000)
  notes          String?       @db.Text
  registeredById String        @map("registered_by_id") @db.Uuid

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, settlementId])
  @@map("settlement_transfers")
}

/// Consolidado mensual por propietario, de cierre manual (3.2, Micaela #7).
/// Uno por propietario y mes; se reabre (admin) si hace falta otro cierre.
model OwnerStatement {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  ownerId          String            @map("owner_id") @db.Uuid
  period           String            @db.VarChar(7)
  status           StatementStatus   @default(OPEN)
  sendMode         StatementSendMode @map("send_mode")
  settlementsCount Int               @default(0) @map("settlements_count")

  closedAt   DateTime? @map("closed_at") @db.Timestamptz(3)
  closedById String?   @map("closed_by_id") @db.Uuid
  notes      String?   @db.Text

  /// PDF vigente del consolidado (Fase 15); lo escribe `documents`.
  pdfKey String? @map("pdf_key") @db.VarChar(500)
  pdfUrl String? @map("pdf_url") @db.VarChar(1000)

  totals OwnerStatementTotal[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([tenantId, ownerId, period])
  @@index([tenantId, status, period])
  @@map("owner_statements")
}

/// Totales del consolidado por moneda, congelados al cerrar.
model OwnerStatementTotal {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  statementId String         @map("statement_id") @db.Uuid
  statement   OwnerStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  currency         Currency
  rentTotal        Decimal  @map("rent_total") @db.Decimal(14, 2)
  lateFeeTotal     Decimal  @map("late_fee_total") @db.Decimal(14, 2)
  chargesTotal     Decimal  @map("charges_total") @db.Decimal(14, 2)
  feeTotal         Decimal  @map("fee_total") @db.Decimal(14, 2)
  expensesTotal    Decimal  @map("expenses_total") @db.Decimal(14, 2)
  adjustmentsTotal Decimal  @map("adjustments_total") @db.Decimal(14, 2)
  netTotal         Decimal  @map("net_total") @db.Decimal(14, 2)
  transferredTotal Decimal  @map("transferred_total") @db.Decimal(14, 2)

  @@unique([statementId, currency])
  @@index([tenantId, statementId])
  @@map("owner_statement_totals")
}

/// Honorario devengado a cobrar (3.3, Micaela #9B y #10): cuenta corriente
/// de honorarios de la inmobiliaria con cada propietario.
model FeeReceivable {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  ownerId       String   @map("owner_id") @db.Uuid
  contractId    String   @map("contract_id") @db.Uuid
  /// La cuota, cuando nace de un pago; null cuando nace de una liquidación.
  installmentId String?  @map("installment_id") @db.Uuid
  period        String   @db.VarChar(7)
  currency      Currency

  source FeeReceivableSource
  payer  FeePayer

  /// Idempotencia: un pago o una liquidación generan un solo receivable.
  originPaymentId    String? @map("origin_payment_id") @db.Uuid
  originSettlementId String? @map("origin_settlement_id") @db.Uuid

  amount     Decimal             @db.Decimal(14, 2)
  paidAmount Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2)
  status     FeeReceivableStatus @default(PENDING)

  /// Cómo se calculó.
  feePercentage  Decimal  @map("fee_percentage") @db.Decimal(5, 2)
  feeAmountFixed Decimal? @map("fee_amount_fixed") @db.Decimal(14, 2)
  baseAmount     Decimal  @map("base_amount") @db.Decimal(14, 2)

  /// El pago de origen se anuló con cobros ya imputados: revisar a mano.
  needsReview Boolean   @default(false) @map("needs_review")
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(3)

  allocations FeePaymentAllocation[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([tenantId, originPaymentId])
  @@unique([tenantId, originSettlementId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, contractId])
  @@map("fee_receivables")
}

/// Pago de honorarios a la inmobiliaria (lo paga el propietario o el
/// inquilino por su cuenta), imputado a los receivables más viejos.
model FeePayment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  ownerId    String  @map("owner_id") @db.Uuid
  contractId String? @map("contract_id") @db.Uuid

  paidAt            DateTime      @map("paid_at") @db.Date
  amount            Decimal       @db.Decimal(14, 2)
  currency          Currency
  method            PaymentMethod
  paidBy            FeePayer      @map("paid_by")
  /// Lo que no alcanzó a imputarse: se aplica a receivables futuros.
  unallocatedAmount Decimal       @map("unallocated_amount") @db.Decimal(14, 2)

  receiptKey     String? @map("receipt_key") @db.VarChar(500)
  receiptUrl     String? @map("receipt_url") @db.VarChar(1000)
  notes          String? @db.Text
  registeredById String  @map("registered_by_id") @db.Uuid

  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  allocations FeePaymentAllocation[]

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@index([tenantId, ownerId, paidAt])
  @@index([tenantId, contractId])
  @@map("fee_payments")
}

/// Cuánto de un pago de honorarios fue a cada receivable.
model FeePaymentAllocation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  feePaymentId    String        @map("fee_payment_id") @db.Uuid
  feePayment      FeePayment    @relation(fields: [feePaymentId], references: [id], onDelete: Cascade)
  feeReceivableId String        @map("fee_receivable_id") @db.Uuid
  feeReceivable   FeeReceivable @relation(fields: [feeReceivableId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, feePaymentId])
  @@index([tenantId, feeReceivableId])
  @@map("fee_payment_allocations")
}

// ---------------------------------------------------------------------------
// Automatizaciones (Fase 13)
// ---------------------------------------------------------------------------

enum JobExecutionStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

enum JobTrigger {
  SCHEDULE
  MANUAL
}

/// Una ejecución de un job de negocio (D-93). **`tenant_id` es opcional**: los
/// jobs globales (índices) no pertenecen a una inmobiliaria. Por eso el modelo
/// no pasa por el filtro de tenant y quien lee filtra a mano por el tenant del
/// contexto o por `tenant_id IS NULL`. Se escribe fuera de un request (cron,
/// worker de la cola).
model JobExecution {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Nombre del job: `installments.generate`, `indices.fetch`...
  job          String             @db.VarChar(60)
  /// Día (hora local de la inmobiliaria) al que corresponde la corrida.
  scheduledFor DateTime           @map("scheduled_for") @db.Date
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(3)
  status       JobExecutionStatus @default(RUNNING)
  /// Cuántas cosas tocó: cuotas creadas, avisos enviados, contratos cerrados.
  affected     Int                @default(0)
  /// Resumen legible: "3 cuotas creadas, 12 ya existían".
  summary      String?            @db.Text
  error        String?            @db.Text
  /// Detalle estructurado (por tipo de índice, por contrato...).
  details      Json?

  triggeredBy       JobTrigger @default(SCHEDULE) @map("triggered_by")
  triggeredByUserId String?    @map("triggered_by_user_id") @db.Uuid

  @@index([tenantId, job, scheduledFor])
  @@index([job, startedAt])
  @@map("job_executions")
}

enum NotificationRecipientKind {
  RENTER
  OWNER
  TENANT_STAFF
  INSURER
}

enum NotificationChannel {
  EMAIL
  WHATSAPP_LINK
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Historial de avisos (D-95). La `dedupe_key` única por inmobiliaria es lo que
/// hace idempotentes a los jobs: un aviso con la misma clave no se manda dos
/// veces. Los avisos internos (`IN_APP` a `TENANT_STAFF`) son los que lee la
/// campana del backoffice; `read_at` los marca leídos. La Fase 14 lo reutiliza
/// como historial de envíos reales.
model NotificationLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  type           String                    @db.VarChar(40)
  recipientKind  NotificationRecipientKind @map("recipient_kind")
  recipientId    String?                   @map("recipient_id") @db.Uuid
  recipientEmail String?                   @map("recipient_email") @db.VarChar(255)
  /// Null en los avisos que no cuelgan de una entidad (índice no disponible).
  entityType     String?                   @map("entity_type") @db.VarChar(40)
  entityId       String?                   @map("entity_id") @db.Uuid
  dedupeKey      String                    @map("dedupe_key") @db.VarChar(200)
  channel        NotificationChannel
  status         NotificationStatus        @default(QUEUED)
  /// Datos para la plantilla; en los internos, además `title`, `body` y `link`.
  payload        Json
  error          String?                   @db.Text
  sentAt         DateTime?                 @map("sent_at") @db.Timestamptz(3)
  readAt         DateTime?                 @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, recipientKind, channel, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("notification_log")
}

// ------------------------------------------------------------ PDFs (Fase 15)

enum DocumentKind {
  SETTLEMENT
  OWNER_STATEMENT
  PAYMENT_RECEIPT
  TERMINATION_NOTICE
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

/// Un PDF generado, en una versión. La vigente de una entidad es la última
/// `READY`; regenerar crea una versión nueva y no pisa el archivo anterior.
/// `entity_id` apunta a la liquidación, el consolidado, el pago o el contrato
/// según `kind` (sin FK: son cuatro tablas de tres módulos).
model GeneratedDocument {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  kind        DocumentKind
  entityId    String         @map("entity_id") @db.Uuid
  version     Int
  status      DocumentStatus @default(PENDING)
  storageKey  String?        @map("storage_key") @db.VarChar(500)
  url         String?        @db.VarChar(1000)
  sizeBytes   Int?           @map("size_bytes")
  error       String?        @db.Text
  generatedAt DateTime?      @map("generated_at") @db.Timestamptz(3)
  /// Quién pidió la regeneración; null si salió de un evento.
  requestedById String?      @map("requested_by_id") @db.Uuid
  /// Los datos con los que se armó: permite re-renderizar igual y detectar
  /// si un evento repetido trae algo distinto.
  dataSnapshot  Json?        @map("data_snapshot")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@unique([tenantId, kind, entityId, version])
  @@index([tenantId, kind, entityId, status])
  @@index([tenantId, status, createdAt])
  @@map("generated_documents")
}
