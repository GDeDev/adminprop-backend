{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    // Permite `import x from 'cjs-module'` en vez de `import * as x`. Además de
    // ser lo correcto hoy, es un requisito para el día que Nest pase a ESM.
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // Los decoradores de NestJS y los DTOs de class-validator declaran
    // propiedades que asigna el framework, no el constructor. Con
    // strictPropertyInitialization habría que marcar todas con `!`, que es ruido
    // sin valor: quien las completa es el ValidationPipe.
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "ts-node": {
    // Sin esto ts-node compila archivo por archivo y se saltea las
    // declaraciones globales de src/types/*.d.ts, con lo cual `request.user`
    // no existe para `npm run prisma:seed` ni para `ts-node src/main.ts`.
    "files": true
  }
}
